# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars*

# cloudflare
.wrangler

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma — generated client, rebuilt by `pnpm postinstall` from the schema
/src/generated

# playwright mcp artifacts
.playwright-mcp
.claude/settings.local.json

*storybook.log
storybook-static

# graphify — generated code knowledge graph (rebuildable via `graphify update .`)
graphify-out/
