{
  "name": "agentdrive",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:tokens": "node scripts/check-design-tokens.mts",
    "test:stories": "vitest run --project storybook",
    "test:filesystem": "vitest run --project filesystem",
    "test:transfer": "vitest run --project transfer",
    "test:sharing": "vitest run --project sharing",
    "test:storage": "vitest run --project storage",
    "test:db": "node scripts/test-drive-item-db.mts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "storage:cors": "node scripts/set-bucket-cors.mts",
    "worker:dev": "wrangler dev --config workers/api/wrangler.jsonc --port 8788",
    "worker:deploy": "wrangler deploy --config workers/api/wrangler.jsonc",
    "worker:typecheck": "tsc --noEmit --project workers/api/tsconfig.json",
    "worker:secrets": "wrangler secret put DATABASE_URL --config workers/api/wrangler.jsonc",
    "emails:check": "node scripts/clerk-emails.mts",
    "emails:push": "node scripts/clerk-emails.mts --push",
    "emails:restore": "node scripts/clerk-emails.mts --restore",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@aws-sdk/xml-builder": "3.972.37",
    "@clerk/backend": "^3.16.8",
    "@clerk/nextjs": "7.7.6",
    "@hono/zod-validator": "^0.9",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-neon": "^7",
    "@prisma/client": "^7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.33",
    "input-otp": "^1.5.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "prisma": "^7",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.118.0",
    "storybook": "^10.5.9",
    "@storybook/nextjs-vite": "^10.5.9",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-mcp": "latest",
    "vite": "latest",
    "vitest": "latest",
    "playwright": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest"
  }
}
