{
  "slug": "password_changed",
  "subject": "Your {{app.name}} password has been changed",
  "markup": "<re-html>\n<re-head>\n    <re-title>\n        Your {{app.name}}\npassword has been changed\n    </re-title>\n</re-head>\n<re-body background-color=\"#fff\" padding=\"48px 32px 48px 32px\">\n    <re-preheader>\n        Your <re-var>{{app.name}}</re-var>\npassword has been changed\n    </re-preheader>\n    <re-header padding=\"16px 32px 8px 32px\">\n        <re-text font-size=\"18px\" font-weight=\"bold\" line-height=\"26px\" color=\"#111827\">\n            {{> app_logo}}\n        </re-text>\n    </re-header>\n    <re-main background-color=\"#fff\" border-radius=\"0px\">\n        <re-block border-radius=\"0px\" align=\"left\" padding=\"32px 32px 48px 32px\" background-color=\"#ffffff\" font-size=\"14px\" font-weight=\"bold\" margin=\"0\" level=\"h1\">\n            <re-heading margin=\"0\" level=\"h1\" align=\"left\" color=\"#111827\" font-size=\"24px\" line-height=\"32px\">Password change</re-heading>\n            <re-text margin=\"32px 0px 0px 0px\" align=\"left\" font-size=\"14px\" color=\"#747686\">{{#if greeting_name}}Hi {{greeting_name}},{{/if}}<br></re-text>\n\n            <re-text margin=\"16px 0px 0px 0px\" font-size=\"14px\" color=\"#747686\">This is an automatic notification to inform you that the password belonging to {{primary_email_address}} has been changed.</re-text>\n            <re-text margin=\"64px 0px 0px 0px\" color=\"#747686\" font-size=\"14px\">\n                <b>Didn't request this?</b>\n            </re-text>\n            <re-text font-size=\"14px\" margin=\"4px 0px 0px 0px\" color=\"#747686\">If you did not make this change, please reach out to an administrator for support.</re-text>\n        </re-block>\n    </re-main>\n    <re-footer padding=\"24px 32px 48px\">\n        <re-divider background-color=\"#B7B8C2\" height=\"1px\"></re-divider>\n        <re-text margin=\"16px 0px 0px 0px\" font-size=\"13px\" color=\"#747686\">&copy; {{current_year}} {{app.name}}</re-text>\n    </re-footer>\n</re-body>\n</re-html>\n"
}
