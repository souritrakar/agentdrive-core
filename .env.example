# Neon Postgres — both strings come from the Neon console for the same project.
#
# DATABASE_URL is the pooled connection (host contains "-pooler"). The app and
# the Worker use it at runtime.
DATABASE_URL=""
#
# DIRECT_URL is the same database without the "-pooler" host segment. Prisma
# Migrate uses it, because DDL needs session state and advisory locks that
# PgBouncer in transaction mode cannot hold.
DIRECT_URL=""

# Disposable Postgres database or Neon branch used only by `pnpm test:db`.
# The guarded runner refuses the normal pooled/direct application database.
TEST_DATABASE_URL=""

# Base URL of the Cloudflare Worker backend (workers/api)
NEXT_PUBLIC_API_URL="http://127.0.0.1:8787"

# ---------------------------------------------------------------------------
# Object storage, over the S3 API.
#
# Cloudflare R2 (current):
#   S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#   S3_REGION="auto"                        # R2 requires "auto"
#   credentials from an R2 API token
#
# AWS S3 (later, if IAM/lifecycle/etc. are needed):
#   S3_ENDPOINT=""                          # leave empty — the SDK resolves it
#   S3_REGION="us-east-1"                   # a real region
#   credentials from an IAM user/role
#
# Nothing in src/storage or its call sites changes between the two.
# ---------------------------------------------------------------------------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Clerk authentication.
#
# Until NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is set the app runs with no auth:
# src/lib/auth.ts short-circuits to a null account scope, the custom auth pages
# redirect away, and the Worker falls back to refusing requests rather than
# serving a shared tenant. Set both keys from the Clerk dashboard to switch
# auth on. Get them from Clerk Dashboard -> API keys.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Where our own auth pages live. Clerk reads these to build redirects, and they
# must match the routes in src/app/(auth)/ — we render custom forms, not the
# prebuilt <SignIn/>/<SignUp/> components.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Webhook signing secret, from Clerk Dashboard -> Webhooks -> your endpoint.
# The webhook backfills each Account's real email and handles user.deleted.
# Account rows are also provisioned just-in-time on first authenticated
# request (src/db/scope.ts), so an unset secret degrades gracefully: the
# webhook route answers 503 and nothing else is affected.
CLERK_WEBHOOK_SIGNING_SECRET=""
